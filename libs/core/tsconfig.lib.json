{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "outDir": "../../dist/out-tsc",
        "declaration": true,
        "inlineSources": true,
        "types": [],
        "useDefineForClassFields": false
    },
    "angularCompilerOptions": {
        "skipTemplateCodegen": true,
        "strictMetadataEmit": true,
        "enableResourceInlining": true,
        "strictTemplates": true
    },
    "exclude": [
        "src/test-setup.ts",
        "src/**/*.spec.ts",
        "src/**/*.test.ts",
        "jest.config.ts"
    ],
    "include": ["src/**/*.ts"]
}
