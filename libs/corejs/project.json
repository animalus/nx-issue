{
    "name": "corejs",
    "$schema": "../../node_modules/nx/schemas/project-schema.json",
    "projectType": "library",
    "sourceRoot": "libs/corejs/src",
    "prefix": "animalus",
    "targets": {
        "build": {
            "executor": "@nx/js:tsc",
            "outputs": ["{options.outputPath}"],
            "options": {
                "outputPath": "dist/{projectRoot}",
                "main": "{projectRoot}/src/index.ts",
                "tsConfig": "libs/corejs/tsconfig.lib.json"
            }
        },
        "test": {
            "executor": "@nx/jest:jest",
            "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
            "options": {
                "jestConfig": "libs/corejs/jest.config.ts"
            }
        },
        "lint": {
            "executor": "@nx/eslint:lint",
            "options": {
                "lintFilePatterns": ["libs/corejs/src/**/*.ts"]
            }
        }
    },
    "tags": []
}
